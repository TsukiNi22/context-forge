#!/usr/bin/env bash
# Bash completion for context-forge
# Install: see instructions at the bottom of this file.

_context_forge_completions()
{
    local cur prev words cword
    _init_completion 2>/dev/null || {
        COMPREPLY=()
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
    }

    local commands="pull install-ollama remove status restart start exec stop setup server check"
    local check_modes="dist local"
    local verbose_levels="none basic advanced debug"

    # Flags that take a value, and how to complete that value
    # (kept as simple case blocks below rather than assoc arrays for portability)

    # Figure out which top-level command (if any) has already been typed
    local cmd=""
    local i
    for ((i = 1; i < COMP_CWORD; i++)); do
        case "${COMP_WORDS[i]}" in
            pull|install-ollama|remove|status|restart|start|exec|stop|setup|server|check)
                cmd="${COMP_WORDS[i]}"
                break
                ;;
        esac
    done

    # Complete the value for an option that expects an argument
    case "$prev" in
        -p|-port|--port)
            COMPREPLY=()
            return 0
            ;;
        -a|-ip|--ip)
            COMPREPLY=()
            return 0
            ;;
        -m|-model|--model)
            COMPREPLY=()
            return 0
            ;;
        -r|-rules|--rules)
            COMPREPLY=($(compgen -d -- "$cur"))
            return 0
            ;;
        -P|-so|--plugins)
            COMPREPLY=($(compgen -d -- "$cur"))
            return 0
            ;;
        -s|--system-prompt)
            COMPREPLY=($(compgen -f -- "$cur"))
            return 0
            ;;
        -d|-fd|--redirect)
            COMPREPLY=($(compgen -W "0 1 2" -- "$cur"))
            return 0
            ;;
        -v|--verbose)
            COMPREPLY=($(compgen -W "$verbose_levels" -- "$cur"))
            return 0
            ;;
        -c|-cmd|--command)
            COMPREPLY=($(compgen -c -- "$cur"))
            return 0
            ;;
    esac

    # `exec -c <bin> [<argument>]*` -> once -c/<bin> have been given,
    # everything further is the target command's own arguments, so hand
    # off to plain file completion instead of our own flags
    if [[ "$cmd" == "exec" ]]; then
        local ci=0
        for ((i = 1; i < COMP_CWORD; i++)); do
            case "${COMP_WORDS[i]}" in
                -c|-cmd|--command) ci=$i; break ;;
            esac
        done
        if (( ci > 0 && COMP_CWORD > ci + 1 )); then
            COMPREPLY=($(compgen -f -- "$cur"))
            return 0
        fi
    fi

    # No command chosen yet -> complete command names
    if [[ -z "$cmd" ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return 0
    fi

    # `check` needs a mode (dist|local) as its next positional word
    if [[ "$cmd" == "check" ]]; then
        local mode=""
        for ((i = 1; i < COMP_CWORD; i++)); do
            case "${COMP_WORDS[i]}" in
                dist|local) mode="${COMP_WORDS[i]}"; break ;;
            esac
        done
        if [[ -z "$mode" ]]; then
            COMPREPLY=($(compgen -W "$check_modes" -- "$cur"))
            return 0
        fi
    fi

    # `pull` takes a model name as its positional argument -> nothing sane to suggest
    if [[ "$cmd" == "pull" && "$prev" == "pull" ]]; then
        COMPREPLY=()
        return 0
    fi

    # Otherwise, suggest flags relevant to the chosen command
    local common_flags="-h -help --help -v --verbose"
    local net_flags="-a -ip --ip -p -port --port"
    local model_flags="-m -model --model"
    local dist_flags="-P -so --plugins -r -rules --rules -R -rec --recursive -s --system-prompt"

    local flags="$common_flags"
    case "$cmd" in
        pull)            flags="$common_flags $model_flags" ;;
        install-ollama)   ;;
        remove)           ;;
        status)          flags="$common_flags $net_flags" ;;
        restart)          ;;
        start)            ;;
        exec)            flags="$common_flags -d -fd --redirect -n -!nl --no-nl -c -cmd --command" ;;
        stop)             ;;
        setup)           flags="$common_flags $net_flags $model_flags $dist_flags -C -cp --copy" ;;
        server)          flags="$common_flags $net_flags $model_flags $dist_flags" ;;
        check)           flags="$common_flags $net_flags $model_flags $dist_flags" ;;
    esac

    COMPREPLY=($(compgen -W "$flags" -- "$cur"))
    return 0
}

complete -F _context_forge_completions context-forge

# ---------------------------------------------------------------------------
# Install / reload
# ---------------------------------------------------------------------------
# One-off, current shell only:
#   source context-forge-completion.bash
#
# Permanent, per-user (Fedora, bash-completion package):
#   mkdir -p ~/.local/share/bash-completion/completions
#   cp context-forge-completion.bash ~/.local/share/bash-completion/completions/context-forge
#   # new shells pick it up automatically; for the current shell:
#   source ~/.local/share/bash-completion/completions/context-forge
#
# Permanent, system-wide:
#   sudo cp context-forge-completion.bash /etc/bash_completion.d/context-forge
#
# Reset/reload after editing the script (without opening a new shell):
#   complete -r context-forge        # drop the old registration
#   source context-forge-completion.bash   # (or the installed path)
#
# Sanity check that it's registered:
#   complete -p context-forge
